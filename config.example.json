{
  "listen": ":18080",
  "base_url": "http://localhost:18080",
  "database": ".data/metadata.db",
  "signing_key": "env:IMGSERVER_SIGNING_KEY",
  "allowed_origins": [
    "http://localhost:3000"
  ],
  "max_concurrent": 4,
  "max_pixels": 25000000,
  "storage": {
    "driver": "s3",
    "bucket": "your-private-media-bucket",
    "region": "us-east-1",
    "endpoint": "",
    "path_style": false
  },
  "profiles": {
    "avatar": {
      "public": true,
      "image_only": true,
      "max_bytes": 5242880,
      "sizes": [
        32,
        64,
        128,
        256
      ],
      "alias": true
    },
    "ticket": {
      "public": false,
      "image_only": false,
      "max_bytes": 26214400,
      "alias": false
    },
    "ticket-image": {
      "public": false,
      "image_only": true,
      "max_bytes": 10485760,
      "sizes": [
        128,
        512,
        1024
      ],
      "alias": false
    }
  }
}
