# Used by Docker Compose. For `go run`, export these variables in your shell.
IMGSERVER_SIGNING_KEY=
IMGSERVER_BASE_URL=http://localhost:18080
# For compose.release.yaml; choose a published version or digest.
IMGSERVER_IMAGE=ghcr.io/sculkdev/imgserver:0.1.0
IMGSERVER_PORT=18080
# Standard AWS SDK credentials. Leave unset on hosts with an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
